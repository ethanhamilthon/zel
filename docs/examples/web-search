#!/bin/bash
# web search via Tavily. usage: web-search <query> [-n 5] [--answer]
# Put the header line "Authorization: Bearer tvly-..." in ~/.config/zel/tavily.hdr.
n=5; a=false; q=()
while [ $# -gt 0 ]; do
  case $1 in -n) n=$2; shift;; --answer) a=true;; *) q+=("$1");; esac; shift
done
jq -n --arg q "${q[*]}" --argjson n "$n" --argjson a "$a" '{query:$q,max_results:$n,include_answer:$a}' |
curl -sS -m 25 https://api.tavily.com/search -H 'Content-Type: application/json' -H @"$HOME/.zel/tavily.hdr" -d @- |
jq -r '(if .answer then "ANSWER: "+.answer+"\n\n" else "" end) + (.detail.error // "") +
       ([.results[]? | "- "+.title+"\n  "+.url+"\n  "+(.content|.[0:500])] | join("\n"))'
